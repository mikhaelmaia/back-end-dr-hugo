# =============================================================================
# MODELO DE VARIÁVEIS DE AMBIENTE — Doutor Viu Back-End
# =============================================================================
# Copie este arquivo para ".env" (na mesma pasta) e preencha os valores.
#   - NÃO commite o ".env" (já está no .gitignore).
#   - NÃO coloque segredos reais neste arquivo de modelo.
#   - NÃO copie segredos de produção para a sua máquina (veja docs/EXECUCAO_LOCAL.md).
# Referência completa de cada variável: docs/EXECUCAO_LOCAL.md (seção "Referência das variáveis")
#
# Legenda dos comentários:
#   [OBRIGATÓRIA]  sem ela a aplicação NÃO sobe (ou falha logo na inicialização)
#   [FUNCIONAL]    a aplicação sobe, mas a funcionalidade citada quebra sem ela
#   [OPCIONAL]     tem valor padrão no código
#   [SEM EFEITO]   o código não usa o valor

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------

# [OPCIONAL] Porta HTTP da API (e do WebSocket /notifications). Padrão: 3000.
PORT=3000

# [OPCIONAL] "production" liga SSL no PostgreSQL (sem validar certificado);
# "development" liga o log de queries e erros do TypeORM. Outro valor/ausente = sem SSL e sem log.
# Valor usado localmente: "development".
NODE_ENV=

# [FUNCIONAL] Nome da aplicação. Usado no cabeçalho User-Agent das chamadas a CFM, ReceitaWS, ViaCEP e CNES.
DV_APP_NAME=

# [FUNCIONAL] Versão da aplicação (texto livre). Usado no User-Agent das chamadas externas.
DV_APP_VERSION=

# [SEM EFEITO] Nenhum código lê DV_ENV. Pode ficar vazia.
DV_ENV=

# [OBRIGATÓRIA] Chave AES-256-GCM. Formato: 64 caracteres hexadecimais (32 bytes).
# Gerar (qualquer SO com Node instalado):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Usada para: criptografar e-mail, CPF/CNPJ, telefone e API key dos usuários e os dados/IP da auditoria;
# e (HMAC-SHA256) para gerar os hashes de busca (email_hash, tax_id_hash, phone_hash, api_key_hash, fingerprint).
# ⚠️ NUNCA troque a chave de um banco que já tem dados: ninguém conseguirá fazer login nem ler esses campos.
CRYPTO_KEY=

# -----------------------------------------------------------------------------
# Front-end (usadas para montar links enviados por e-mail, WhatsApp e QR Code)
# Todos os caminhos começam com "/". A base não termina com "/".
# -----------------------------------------------------------------------------

# [FUNCIONAL] URL base do front-end. Ex.: http://localhost:5173
DV_WEB_BASE_URL=
# [FUNCIONAL] Tela de login.
DV_WEB_LOGIN_PATH=
# [FUNCIONAL] Tela de redefinição de senha (recebe ?t=<chave de resolução>).
DV_WEB_FORGOT_PASSWORD_PATH=
# [FUNCIONAL] Tela de confirmação de e-mail do cadastro (recebe ?t=...).
DV_WEB_EMAIL_CONFIRMATION_PATH=
# [SEM EFEITO] Lida em configuration.ts, mas nenhum código usa web.emailChangeConfirmationPath.
DV_WEB_EMAIL_CHANGE_CONFIRMATION_PATH=
# [FUNCIONAL] Tela de confirmação de troca de e-mail/telefone (usada pelo e-mail e pelo WhatsApp).
DV_WEB_PROFILE_CHANGE_CONFIRMATION_PATH=
# [SEM EFEITO] Lida em configuration.ts, mas nenhum código usa web.phoneChangeConfirmationPath
# (a troca de telefone usa DV_WEB_PROFILE_CHANGE_CONFIRMATION_PATH).
DV_WEB_PHONE_CHANGE_CONFIRMATION_PATH=
# [FUNCIONAL] Tela de solicitação de permissão: destino do QR Code de acesso do paciente (?t=...).
DV_WEB_PERMISSION_REQUEST_PATH=
# [FUNCIONAL] Tela do paciente para ver um médico vinculado (links de WhatsApp).
DV_WEB_GRANTED_DOCTOR_PATH=
# [FUNCIONAL] Tela do paciente para ver uma instituição vinculada (links de WhatsApp).
DV_WEB_GRANTED_INSTITUTION_PATH=
# [FUNCIONAL] Tela do médico/instituição para ver um paciente vinculado (links de WhatsApp).
DV_WEB_GRANTED_PATIENT_PATH=
# [FUNCIONAL] Tela do paciente para ver um documento enviado por instituição (link de WhatsApp).
DV_WEB_DOCUMENT_FORM_PATH=

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# -----------------------------------------------------------------------------

# [OBRIGATÓRIA] Host do PostgreSQL. Local: localhost (API no host) ou "postgres" (API dentro do docker-compose).
DATABASE_HOST=
# [OPCIONAL] Porta. Padrão: 5432.
DATABASE_PORT=5432
# [OBRIGATÓRIA] Usuário do banco.
DATABASE_USER=
# [OBRIGATÓRIA] Senha do banco.
DATABASE_PASSWORD=
# [OBRIGATÓRIA] Nome do banco (precisa existir antes de rodar a API/migrations).
DATABASE_NAME=

# -----------------------------------------------------------------------------
# E-mail (SMTP)
# -----------------------------------------------------------------------------
# O envio é SÍNCRONO: um SMTP incorreto faz falhar os fluxos que enviam e-mail (cadastro, recuperação de senha...).

# [FUNCIONAL] Host do servidor SMTP.
SMTP_HOST=
# [FUNCIONAL] Porta. Padrão no código: 587. ATENÇÃO: o transporte é criado com secure=true (TLS implícito),
# que normalmente usa a porta 465. Confirme a porta correta com o provedor.
SMTP_PORT=
# [FUNCIONAL] Usuário SMTP. Também é usado como remetente ("from") de todos os e-mails.
SMTP_USERNAME=
# [FUNCIONAL] Senha (ou senha de aplicativo) do SMTP.
SMTP_PASSWORD=
# [SEM EFEITO] Lida em configuration.ts mas ignorada: o transporte fixa secure=true.
SMTP_SECURE=
# [SEM EFEITO] Nenhum código lê SMTP_FROM; o remetente é SMTP_USERNAME.
SMTP_FROM=

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------

# [FUNCIONAL] Segredo de assinatura dos tokens (também valida o handshake do WebSocket). String longa e aleatória.
JWT_SECRET=
# [FUNCIONAL] Validade do access token. Formato com unidade: 15m, 1h, 7d.
# ⚠️ Número puro em string (ex.: "3600") é interpretado pela biblioteca como milissegundos.
JWT_EXPIRES_IN=
# [FUNCIONAL] Validade do refresh token. Mesmo formato. Ex.: 7d
JWT_REFRESH_EXPIRES_IN=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# [OBRIGATÓRIA] Host do Redis (a aplicação lança erro na inicialização se faltar).
REDIS_HOST=
# [OBRIGATÓRIA] Porta do Redis, 1–65535 (redis.config.ts NÃO aplica padrão; faltando, a aplicação não sobe).
REDIS_PORT=6379
# [OPCIONAL] Senha do Redis. Vazia = sem senha. (No docker-compose a senha é obrigatória para o container subir.)
REDIS_PASSWORD=
# [OPCIONAL] Índice do banco lógico do Redis. Padrão: 0.
REDIS_DB=0
# [OPCIONAL] TTL padrão do cache, em segundos (> 0). Padrão: 60.
REDIS_TTL=60

# -----------------------------------------------------------------------------
# MinIO (armazenamento de arquivos)
# -----------------------------------------------------------------------------

# [OBRIGATÓRIA] Host do MinIO, SEM porta e SEM protocolo (ex.: minio.exemplo.com ou localhost).
MINIO_ENDPOINT=
# [FUNCIONAL] Porta da API do MinIO. Local (docker-compose): 9000. Atrás de proxy HTTPS: 443.
MINIO_PORT=9000
# [OBRIGATÓRIA] Chave de acesso. No docker-compose vira o usuário root do MinIO.
MINIO_ACCESS_KEY=
# [OBRIGATÓRIA] Chave secreta. No docker-compose vira a senha root do MinIO (a imagem exige mínimo de 8 caracteres).
MINIO_SECRET_KEY=
# [FUNCIONAL] "true" liga HTTPS. Qualquer outro valor = HTTP.
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# APIs externas
# -----------------------------------------------------------------------------

# --- CFM (consulta de médicos por CRM) ---
# [FUNCIONAL] URL do serviço SOAP do CFM. Sem ela o cadastro de médicos não valida o CRM.
CFM_API_URL=
# [FUNCIONAL] Chave de acesso ao serviço do CFM (enviada no corpo SOAP). Obtida junto ao CFM.
CFM_API_KEY=
# [OPCIONAL] Timeout em ms. Padrão: 5000.
CFM_API_TIMEOUT=5000

# --- ReceitaWS (consulta de CNPJ) ---
# [FUNCIONAL] URL base. Sem ela a validação de CNPJ da instituição falha.
RECEITAWS_API_URL=
# [FUNCIONAL] Caminho do recurso de CNPJ, concatenado como {URL}{CAMINHO}/{cnpj}.
RECEITAWS_COMPANY_DATA_PATH=
# [OPCIONAL] Timeout em ms. Padrão: 30000.
RECEITAWS_API_TIMEOUT=30000

# --- ViaCEP (consulta de CEP) ---
# [FUNCIONAL] URL base, sem barra final (a chamada é {URL}/{cep}/json).
VIA_CEP_API_URL=
# [OPCIONAL] Timeout em ms. Padrão: 3000.
VIA_CEP_API_TIMEOUT=3000

# --- CNES (consulta de estabelecimentos de saúde) ---
# [FUNCIONAL] URL base da API de CNES. Sem ela o cadastro de instituição não valida o CNES.
CNES_API_URL=
# [FUNCIONAL] Caminho do recurso de estabelecimento, concatenado como {URL}{CAMINHO}/{cnes}.
CNES_ESTABLISHMENT_PATH=
# [OPCIONAL] Timeout em ms. Padrão: 30000.
CNES_API_TIMEOUT=30000

# --- Z-API (envio de WhatsApp) ---
# [FUNCIONAL] URL base da Z-API. Sem URL/instância/token, nenhuma mensagem de WhatsApp é enviada.
ZAPI_API_URL=
# [FUNCIONAL] ID da instância Z-API (vai no caminho da URL).
ZAPI_INSTANCE_ID=
# [FUNCIONAL] Token da instância Z-API (vai no caminho da URL). Segredo.
ZAPI_TOKEN=
# [FUNCIONAL] Client-Token da conta Z-API (cabeçalho). Segredo.
ZAPI_CLIENT_TOKEN=
# [OPCIONAL] Timeout em ms. Padrão: 5000.
ZAPI_API_TIMEOUT=5000
